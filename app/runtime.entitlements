<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Applied to the bundled python3 and radare2 executables. They load
         third-party native libraries (capstone, pycryptodome, apple-compress,
         the libr_* dylibs) that are not all signed by our team, so library
         validation must be relaxed for these interpreters. The main app does
         NOT carry this entitlement. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
